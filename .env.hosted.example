# Hosted build (Render). Copy the values into the Render dashboard.
# The demo build uses .env with LLM_BASE_URL=http://127.0.0.1:11434 and no key.

DEPLOYMENT=hosted
BACKEND=server
MOCK_MODE=false

# Any OpenAI-compatible endpoint that serves a Gemma model.
LLM_BASE_URL=https://<your-provider>/api
MODEL_NAME=<the provider's Gemma model id>
LLM_API_KEY=<set in the Render dashboard, never commit>
LLM_TIMEOUT_S=60

ASR_BACKEND=whisper
ASR_MODEL=base
LANGUAGE=kn
