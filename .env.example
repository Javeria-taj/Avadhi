# Copy to .env and adjust. Never commit .env.

# --- inference -------------------------------------------------------------
# server = local OpenAI-compatible HTTP server (Ollama / llama-server).
#          Works on Windows AND macOS. Still fully offline.  <-- recommended
# mlx    = in-process Apple Silicon inference. Mac only, lowest latency.
BACKEND=server
LLM_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=gemma3:4b
LLM_TIMEOUT_S=120

# Only needed when BACKEND=mlx
MODEL_PATH=./models/gemma-4b

# --- speech --------------------------------------------------------------
# whisper    = faster-whisper in-process (Mac / Windows / Linux)
# whispercpp = shell out to a whisper.cpp binary (required on Termux, where
#              ctranslate2 has no aarch64-Android wheel)
ASR_BACKEND=whisper
ASR_MODEL=small
LANGUAGE=kn

# Only needed when ASR_BACKEND=whispercpp
WHISPERCPP_BIN=whisper-cli
WHISPERCPP_MODEL=./models/ggml-small.bin

# --- development ---------------------------------------------------------
# true = run the whole pipeline with no model at all. Use for UI work and as
# the emergency demo fallback.
MOCK_MODE=false
